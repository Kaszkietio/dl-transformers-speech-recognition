{
  "experiment_name": "silence_voice",
  "seed": 1,
  "data_path": "./data/silence_dataset",
  "model": "CNN_SA",
  "model_params": {
    "num_classes": 2,
    "num_heads": 4,
    "dim_model": 128,
    "dim_ff": 512,
    "num_layers": 1,
    "dropout": 0.3
  },
  "optimizer": "AdamW",
  "optimizer_params": {
    "lr": 0.001,
    "weight_decay": 0.05
  },
  "epochs": 80,
  "warmup_epochs": 10,
  "batch_size": 512,
  "checkpoint_folder": "./checkpoints/silence_voice",
  "scheduler": "SequentialLR",
  "scheduler_params": {
    "schedulers": {
      "LinearLR": {
        "start_factor": 0.5,
        "end_factor": 1,
        "total_iters": 10
      },
      "ExponentialLR": {
        "gamma": 0.9
      }
    },
    "milestones": [
      10
    ]
  },
  "early_stopping": {
    "patience": 10,
    "min_delta": 0.001
  }
}